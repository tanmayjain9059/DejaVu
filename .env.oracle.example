# Copy to .env.oracle on the Oracle VM and chmod 600 .env.oracle.
# Use your real domain and secrets. Never commit this file.
APP_ENV=production
DOMAIN=lostlink.example.in
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@<session-pooler-host>:5432/postgres?sslmode=require
DATABASE_POOL_MAX_SIZE=3
SESSION_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
ALLOWED_HOSTS=lostlink.example.in
DEMO_MODE=false
SESSION_HTTPS_ONLY=true
REQUIRE_REQUEST_ORIGIN=true
DATA_DIR=/tmp/lostlink
UPLOAD_DIR=/tmp/lostlink/uploads
OBJECT_STORAGE_BUCKET=lostlink-private
OBJECT_STORAGE_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
OBJECT_STORAGE_ACCESS_KEY_ID=<supabase-s3-access-key>
OBJECT_STORAGE_SECRET_ACCESS_KEY=<supabase-s3-secret-key>
OBJECT_STORAGE_REGION=<exact-region-from-supabase-s3-settings>
INSTALL_ML=true
USE_SEMANTIC_MODEL=true
# CLIP is supported but disabled on the free-tier baseline due to per-candidate CPU cost.
# Set true only after measuring latency and memory on the VM.
USE_CLIP_MODEL=false
