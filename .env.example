# Copy this file to .env, then replace SESSION_SECRET with a unique random value.
# Optional managed PostgreSQL database. Leave unset to use local SQLite.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Optional PostgreSQL connection pool size (1-20, defaults to 5).
# DATABASE_POOL_MAX_SIZE=5
# LostLink intentionally refuses to start when this placeholder is unchanged.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Demo accounts and sample data are created only when DEMO_MODE=true.
DEMO_MODE=true
SESSION_SECRET=replace-with-a-long-random-secret-before-running
SESSION_HTTPS_ONLY=false
# Optional in local development; production Compose requires an explicit canonical host allowlist.
# ALLOWED_HOSTS=localhost,127.0.0.1
# Production Compose enables this to reject state-changing browser requests without Origin/Referer.
# REQUIRE_REQUEST_ORIGIN=false
DATABASE_PATH=./data/lostlink.db
UPLOAD_DIR=./data/uploads
# Optional private S3-compatible object storage (e.g. a private Cloudflare R2 bucket).
# When all four values are set, report photos and private claim evidence use the bucket.
# Keep the bucket private; LostLink serves images through authenticated routes.
# OBJECT_STORAGE_BUCKET=lostlink-private-uploads
# OBJECT_STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# OBJECT_STORAGE_ACCESS_KEY_ID=<r2-access-key-id>
# OBJECT_STORAGE_SECRET_ACCESS_KEY=<r2-secret-access-key>
# OBJECT_STORAGE_REGION=auto
# Optional verified campus directory. Values must be JSON arrays of strings.
# Without these settings, users can select "Other / not sure" and describe the area.
# Do not populate these with unverified campus names.
# CAMPUS_BLOCKS=["<verified building>","<verified common area>"]
# CAMPUS_FLOORS=["Ground","1","2","3"]
# Optional pretrained matching models. Install requirements-ml.txt before enabling.
USE_SEMANTIC_MODEL=false
SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
USE_CLIP_MODEL=false
CLIP_MODEL=openai/clip-vit-base-patch32
