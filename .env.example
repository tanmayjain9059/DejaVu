# Copy this file to .env, then replace SESSION_SECRET with a unique random value.
# Optional managed PostgreSQL database. Leave unset to use local SQLite.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Authentication provider: local (development) or supabase (deployed environments).
AUTH_PROVIDER=local
# Supabase project URL and publishable/anon key. Never put the service-role key in the browser.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_REQUIRE_CONFIRMED_EMAIL=true
# Exact, comma-separated emails provisioned as office users. Everyone else is a student.
# OFFICE_USER_EMAILS=lostandfound.office@college.edu
# Comma-separated exact frontend origins for the split deployment.
# FRONTEND_ORIGINS=https://lostlink.vercel.app
# Optional PostgreSQL connection pool size (1-20, defaults to 5).
# DATABASE_POOL_MAX_SIZE=5
# LostLink intentionally refuses to start when this placeholder is unchanged.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Demo accounts and sample data are created only when DEMO_MODE=true.
DEMO_MODE=true
SESSION_SECRET=replace-with-a-long-random-secret-before-running
SESSION_HTTPS_ONLY=false
# Optional in local development; production Compose requires an explicit canonical host allowlist.
# ALLOWED_HOSTS=localhost,127.0.0.1
# Production Compose enables this to reject state-changing browser requests without Origin/Referer.
# REQUIRE_REQUEST_ORIGIN=false
DATABASE_PATH=./data/lostlink.db
UPLOAD_DIR=./data/uploads
# Private upload storage: local (default) or s3 for S3-compatible object storage.
# S3_BUCKET=your-private-bucket
# S3_PREFIX=lostlink-private
# S3_REGION=ap-south-1
# Supabase Storage S3 endpoint: https://your-project-ref.storage.supabase.co/storage/v1/s3
# S3_ENDPOINT_URL=https://your-project-ref.supabase.co/storage/v1/s3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Never enable public bucket access; image/evidence reads stay behind authenticated API routes.
UPLOAD_STORAGE_BACKEND=local
# Bounded candidate shortlist: 100–10000; defaults to 2000.
MATCHING_CANDIDATE_LIMIT=2000
# Optional pretrained matching models. Install requirements-ml.txt before enabling.
# The first matching request downloads model weights; later runs reuse the local cache.
# Keep disabled for a lightweight deployment that has not installed the ML dependencies.
USE_SEMANTIC_MODEL=false
SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Increment this when model weights/tokenisation change to invalidate old vectors.
SEMANTIC_MODEL_REVISION=default
USE_CLIP_MODEL=false
CLIP_MODEL=openai/clip-vit-base-patch32
# Increment this when CLIP weights/tokenisation change to invalidate image and text vectors.
CLIP_MODEL_REVISION=default
# Optional BLIP photo captioning; model weights are downloaded on first use.
# Enable only after installing requirements-ml.txt and checking host RAM/latency.
USE_IMAGE_ENRICHMENT=false
IMAGE_CAPTION_MODEL=Salesforce/blip-image-captioning-base
